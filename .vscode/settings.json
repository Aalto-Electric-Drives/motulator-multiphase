{
    "editor.rulers": [
        88,
    ],
    "editor.formatOnType": false,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
        "source.fixAll.markdownlint": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "ruff.lineLength": 88,
    "esbonio.sphinx.confDir": "${workspaceFolder}/docs/source",
    "cSpell.words": [
        "autoapi",
        "bibtex",
        "Bojoi",
        "Briz",
        "Degner",
        "dejavuserif",
        "Dordevic",
        "Esbonio",
        "figsize",
        "fontset",
        "fontsize",
        "fromkeys",
        "gradnet",
        "Hinkkanen",
        "intersphinx",
        "IPMSM",
        "labelsize",
        "lims",
        "linalg",
        "Lorenz",
        "mathbf",
        "mathjax",
        "mathrm",
        "mathtext",
        "matplotlib",
        "motulator",
        "multiphase",
        "ncols",
        "ndarray",
        "newtxmath",
        "newtxtext",
        "numpy",
        "numpydoc",
        "PMSM",
        "pwms",
        "pylint",
        "Pyright",
        "pytest",
        "rtol",
        "Rubino",
        "Saarakkala",
        "scipy",
        "sensored",
        "sensorless",
        "SPMSM",
        "titlesonly",
        "toctree",
        "upgreek",
        "uppsi",
        "usepackage",
        "usetex",
        "xlabel",
        "xlim",
        "xtick",
        "ylabel",
        "ylabels",
        "ytick"
    ],
}
